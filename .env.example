# ==============================================================================
# SMS Flink ETL - 环境变量配置模版 (.env.example)
# 复制此文件为 .env 并填入实际凭据后即可本地调试
# ==============================================================================

# 1. Gmail IMAP 收信凭据
GMAIL_IMAP_USER=your_email@gmail.com
GMAIL_IMAP_PASS=your_app_password
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
IMAP_MAX_BATCH_SIZE=200
FLINK_PARALLELISM=2
# 消费切片模式: EARLIEST_FIRST (正向全量补录，默认) / LATEST_FIRST (倒序最新窗口优先)
IMAP_SYNC_MODE=EARLIEST_FIRST

# 2. 网络代理配置 (可选)
IMAP_PROXY_HOST=127.0.0.1
IMAP_PROXY_PORT=7890

# 3. Cloudflare R2 对象存储凭据
R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_S3_ACCESS_KEY_ID=your_access_key_id
R2_S3_SECRET_ACCESS_KEY=your_secret_access_key
# 存储桶物理隔离规范: 生产使用 sms-flink-etl，开发与单测使用 sms-flink-etl-dev
R2_BUCKET_NAME=sms-flink-etl-dev
R2_REGION=auto

# 4. Iceberg Catalog 湖仓元数据配置
ICEBERG_CATALOG_NAME=finance
ICEBERG_CATALOG_TYPE=jdbc
ICEBERG_CATALOG_URI=jdbc:postgresql://<host>:26257/iceberg-catalog?sslmode=require
ICEBERG_CATALOG_USER=finance_user
ICEBERG_CATALOG_PASSWORD=your_password
ICEBERG_CATALOG_SCHEMA=finance_dev
# Warehouse 目录会自动依据 ICEBERG_CATALOG_SCHEMA 后缀动态切换 (开发: s3a://sms-flink-etl-dev/iceberg/warehouse, 生产: s3a://sms-flink-etl/iceberg/warehouse)
ICEBERG_WAREHOUSE_DIR=s3a://sms-flink-etl-dev/iceberg/warehouse
# Iceberg 原生原子性 Upsert 配置 (基于 Format V2 Equality Deletes 幂等写入，防重主键需包含分区基准字段)
ICEBERG_UPSERT_ENABLED=true
ICEBERG_UPSERT_EQUALITY_COLUMNS=msg_uid,received_at

# DWD 批处理单批次处理记录数上限 (防止冷启动或积压时超大窗口)
DWD_MAX_BATCH_SIZE=500

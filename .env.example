# ==============================================================================
# SMS Flink ETL - 环境变量配置模版 (.env.example)
# 复制此文件为 .env 并填入实际凭据后即可本地调试
# ==============================================================================

# 1. Gmail IMAP 收信凭据
GMAIL_IMAP_USER=your_email@gmail.com
GMAIL_IMAP_PASS=your_app_password
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

# 2. 网络代理配置 (可选)
IMAP_PROXY_HOST=127.0.0.1
IMAP_PROXY_PORT=7890

# 3. Cloudflare R2 对象存储凭据
R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_S3_ACCESS_KEY_ID=your_access_key_id
R2_S3_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=sms-flink-etl
R2_REGION=auto

# 4. Iceberg Catalog 湖仓元数据配置
ICEBERG_CATALOG_NAME=finance
ICEBERG_CATALOG_TYPE=jdbc
ICEBERG_CATALOG_URI=jdbc:postgresql://<host>:26257/finance-db?sslmode=require
ICEBERG_CATALOG_USER=finance_user
ICEBERG_CATALOG_PASSWORD=your_password
ICEBERG_WAREHOUSE_DIR=s3a://sms-flink-etl/iceberg/warehouse
